# development | test | production
NODE_ENV=development
PORT=3000

# Docker (npm run db:up) listens on 5433 so it never clashes with a local PostgreSQL on 5432.
DATABASE_URL=postgresql://thrivecbt:thrivecbt@localhost:5433/thrivecbt

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Signs login tokens. At least 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=

# How emails are sent: "unosend", or "log" to print them to the server log
# for local work. Production refuses to start with "log".
EMAIL_TRANSPORT=log
# Must be on a domain verified in Unosend.
EMAIL_FROM=ThriveCBT <no-reply@thrivecbt.app>
# From the Unosend dashboard (starts with un_). Never commit a real key.
UNOSEND_API_KEY=
UNOSEND_API_URL=https://api.unosend.co/v1

# Start of links in emails that open the app (the app's URL scheme).
APP_LINK_BASE=thrivecbt://

# 32 random bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
