# development | test | production
NODE_ENV=development
PORT=3000

# Docker (npm run db:up) listens on 5433 so it never clashes with a local PostgreSQL on 5432.
DATABASE_URL=postgresql://thrivecbt:thrivecbt@localhost:5433/thrivecbt
# End-to-end tests only run against a database whose name contains "test".
TEST_DATABASE_URL=postgresql://thrivecbt:thrivecbt@localhost:5433/thrivecbt_test

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# 32 random bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
