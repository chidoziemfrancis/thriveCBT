                      "required": [
                        "code",
                        "message",
                        "requestId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "error": {
                    "code": "HEALTH_DATABASE_DOWN",
                    "message": "The service is briefly unavailable. Please try again shortly.",
                    "requestId": "0193c3c1-6c2d-7b51-9b6e-2f4a6c8d9e10"
