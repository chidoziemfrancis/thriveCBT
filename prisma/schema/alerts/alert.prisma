model Alert {
  id           String    @id @default(uuid(7)) @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  // Empty until the student is matched; the study lead is told in the meantime.
  researcherId String?   @map("researcher_id") @db.Uuid
  kind         AlertKind
  urgent       Boolean
  title        String
  quote        String?
  detail       String?
  sourceId     String    @map("source_id")
  raisedAt     DateTime  @default(now()) @map("raised_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  student    User  @relation("StudentAlerts", fields: [studentId], references: [id], onDelete: Cascade)
  researcher User? @relation("ResearcherAlerts", fields: [researcherId], references: [id], onDelete: SetNull)

  @@unique([kind, sourceId])
  @@index([researcherId, raisedAt])
  @@index([studentId])
  @@map("alerts")
}

enum AlertKind {
  QUESTION_9
  EPQR_WISH
  RISK_WORDS
  PHQ9_RISE
  SEVERE
  INACTIVE

  @@map("alert_kind")
}
