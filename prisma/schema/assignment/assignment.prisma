model Assignment {
  id           String           @id @default(uuid(7)) @db.Uuid
  studentId    String           @unique @map("student_id") @db.Uuid
  researcherId String           @map("researcher_id") @db.Uuid
  method       AssignmentMethod
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  student    User @relation("StudentAssignment", fields: [studentId], references: [id], onDelete: Cascade)
  researcher User @relation("ResearcherCaseload", fields: [researcherId], references: [id], onDelete: Restrict)

  @@index([researcherId])
  @@map("assignments")
}

enum AssignmentMethod {
  INVITE
  RANDOM

  @@map("assignment_method")
}
