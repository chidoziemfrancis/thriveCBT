/// Something good the student noted about themselves. The id comes from the phone; the text is
/// encrypted with the field key and emptied when deleted, leaving a marker.
model PositiveEntry {
  id        String       @id @db.Uuid
  studentId String       @map("student_id") @db.Uuid
  kind      PositiveKind
  text      String?
  at        DateTime
  updatedAt DateTime     @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")
  syncedAt  DateTime     @updatedAt @map("synced_at")
  createdAt DateTime     @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, syncedAt])
  @@map("positive_entries")
}

enum PositiveKind {
  STRENGTH
  WIN
  KIND
  OTHER

  @@map("positive_kind")
}
