/// A stressful moment the student logged. The situation and what helped are their own words,
/// encrypted with the field key and emptied when deleted.
model StressEntry {
  id        String    @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  situation String?
  level     Int?
  helped    String?
  at        DateTime
  updatedAt DateTime  @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  syncedAt  DateTime  @updatedAt @map("synced_at")
  createdAt DateTime  @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, id])
  @@index([studentId, syncedAt])
  @@map("stress_entries")
}
