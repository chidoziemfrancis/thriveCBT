model User {
  id        String     @id @default(uuid(7)) @db.Uuid
  email     String     @unique
  role      UserRole
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@index([role])
  @@map("users")
}

enum UserRole {
  STUDENT
  RESEARCHER
  LEAD

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN

  @@map("user_status")
}
